<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="30dp"
    android:background="#F8F9FA">

    <!-- TokenX -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="TokenX"
        android:textColor="#172B4D"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Heading -->
    <TextView
        android:id="@+id/tvForgotPasswordTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Forgot Password?"
        android:textColor="#172B4D"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvForgotPasswordDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Enter your phone number or email to reset your password."
        android:textColor="#6B7280"
        android:textSize="14sp"
        android:gravity="center" />

    <!-- Phone / Email -->
    <EditText
        android:id="@+id/etPhoneEmail"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="40dp"
        android:hint="Phone Number or Email"
        android:inputType="text"
        android:textColor="#121212"
        android:padding="15dp"
        android:backgroundTint="#172B4D" />

    <!-- Send OTP -->
    <Button
        android:id="@+id/btnSendOtp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:text="SEND OTP"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2563EB" />

</LinearLayout>